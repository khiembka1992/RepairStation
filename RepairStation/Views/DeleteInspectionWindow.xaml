<Window x:Class="AI_AOI.Views.DeleteInspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Delete Inspection"
        Height="330"
        Width="560"
        Background="{StaticResource AppScreenBackgroundBrush}"
        Foreground="{StaticResource AppTextPrimaryBrush}">
    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Margin="0,0,0,14"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="Yellow"
                       TextWrapping="Wrap"
                       Text="Delete current inspection"/>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,0,0,14"
                       TextWrapping="Wrap"
                       Text="{Binding InspectionMessage}"/>

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Margin="0,0,0,16"
                       Foreground="#FFB3B3"
                       TextWrapping="Wrap"
                       Text="This permanently deletes the inspection from Repair-AI."/>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Password"/>
            <PasswordBox x:Name="pbPassword"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="30"
                         Margin="0,0,0,6"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource AppInputBackgroundBrush}"
                         Foreground="{StaticResource AppTextSecondaryBrush}"
                         BorderBrush="#666666"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <TextBlock x:Name="tbError"
                       Grid.Row="4"
                       Grid.Column="1"
                       Margin="0,0,0,10"
                       Foreground="#FF6B6B"
                       Text="Incorrect password."
                       Visibility="Collapsed"/>

            <StackPanel Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="100"
                        Margin="0,0,8,0"
                        Content="Delete"
                        IsDefault="True"
                        Click="DeleteButton_Click"
                        Style="{StaticResource AppToolbarButtonStyle}"/>
                <Button Width="100"
                        Content="Cancel"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Style="{StaticResource AppToolbarButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
